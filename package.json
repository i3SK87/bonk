{
  "name": "bonk",
  "productName": "BONK",
  "version": "1.35.0",
  "description": "Gestor de finanzas personales para Windows",
  "author": "okli2",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=out/test/smoke.mjs --external:node:* --alias:@shared=./src/shared && node out/test/smoke.mjs",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "pack": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@43.4.0": true,
    "electron-winstaller@5.4.0": true
  }
}
